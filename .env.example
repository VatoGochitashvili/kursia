# ─────────────────────────────────────────────────────────────────────────────
# Kursia — environment configuration.  Copy to `.env` and fill in.
# NEVER commit .env.  No real key belongs in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Branding ────────────────────────────────────────────────────────────────
# The platform name appears nowhere as a literal. Change it here (and/or in
# Admin → Settings, which overrides this) to rename the product.
PLATFORM_NAME="Kursia"
PLATFORM_NAME_KA="კურსია"
PLATFORM_TAGLINE_KA="ისწავლე. შექმენი. გამოიმუშავე."
PLATFORM_SUPPORT_EMAIL="info@kursia.ge"

# ── URLs ────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database ────────────────────────────────────────────────────────────────
# Dev (zero setup):   sqlite   + file:./dev.db
# Production:         postgresql + postgresql://user:pass@host:5432/kursia
# The schema is written to run unchanged on both.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
AUTH_SECRET="replace-me-with-openssl-rand-hex-32"
MEDIA_SIGNING_SECRET="replace-me-with-openssl-rand-hex-32"
CERTIFICATE_SIGNING_SECRET="replace-me-with-openssl-rand-hex-32"

# ── File & video storage ────────────────────────────────────────────────────
# STORAGE_DRIVER: "local" (dev) | "s3" (any S3-compatible: AWS, R2, Backblaze)
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# VIDEO_DRIVER: "storage" (stream from STORAGE_DRIVER) | "bunny" | "mux"
# Swappable — see src/lib/video/README.md
VIDEO_DRIVER="storage"
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME=""
BUNNY_TOKEN_AUTH_KEY=""
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""

# Hosts allowed for next/image (comma separated)
IMAGE_REMOTE_HOSTS="images.unsplash.com"

# ── Payments ────────────────────────────────────────────────────────────────
# Active providers, comma separated, in display order.
# Available drivers: "bog" (Bank of Georgia), "tbc" (TBC Bank), "manual"
#   (bank transfer, admin confirms), "sandbox" (dev only — see note below).
PAYMENT_PROVIDERS="sandbox,manual"
PAYMENT_DEFAULT_PROVIDER="sandbox"

# The sandbox driver NEVER auto-completes a payment. It issues a real pending
# transaction that must be settled by a signed callback to the webhook
# endpoint, exactly like a live bank. Leave false unless you are testing.
PAYMENT_SANDBOX_ENABLED="true"
PAYMENT_SANDBOX_SECRET="replace-me-with-openssl-rand-hex-32"

# Bank of Georgia — https://api.bog.ge (iPay / Payments API)
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
BOG_API_BASE="https://api.bog.ge"
BOG_PUBLIC_KEY=""          # PEM used to verify Callback-Signature header

# TBC Bank — https://tbcbank.ge (E-Commerce API)
TBC_API_KEY=""
TBC_CLIENT_ID=""
TBC_CLIENT_SECRET=""
TBC_API_BASE="https://api.tbcbank.ge"
TBC_WEBHOOK_SECRET=""

# ── Commerce defaults (admin-editable at runtime in Admin → Settings) ───────
DEFAULT_CURRENCY="GEL"
# Platform commission in basis points. 1000 bps = 10%.
DEFAULT_COMMISSION_BPS="1000"
# Days a sale stays "pending" before becoming withdrawable.
PAYOUT_CLEARING_DAYS="14"
PAYOUT_MINIMUM_MINOR="5000"        # ₾50.00
REFUND_WINDOW_DAYS="14"

# ── Email ───────────────────────────────────────────────────────────────────
# EMAIL_DRIVER: "log" (dev — writes to console + outbox) | "smtp" | "resend"
EMAIL_DRIVER="log"
EMAIL_FROM="Kursia <no-reply@kursia.ge>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# ── Security ────────────────────────────────────────────────────────────────
SESSION_TTL_DAYS="30"
RATE_LIMIT_ENABLED="true"
# Trust X-Forwarded-For only behind a proxy you control.
TRUST_PROXY="false"

# ── Bootstrap admin (used by `npm run db:seed`) ─────────────────────────────
SEED_ADMIN_EMAIL="admin@kursia.ge"
SEED_ADMIN_PASSWORD="Admin123!"

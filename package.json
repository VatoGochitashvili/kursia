{
  "name": "kursia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "node scripts/set-db-provider.mjs && prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/set-db-provider.mjs && prisma db push --skip-generate",
    "db:generate": "node scripts/set-db-provider.mjs && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && npm run db:push && npm run db:generate && npm run db:seed",
    "db:studio": "node scripts/set-db-provider.mjs && prisma studio",
    "db:migrate": "node scripts/set-db-provider.mjs && prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
